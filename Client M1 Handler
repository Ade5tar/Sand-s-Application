local INPUT_QUEUE_WINDOW = 0.45


local function canSlideNow(char)
	if not char or not char.Parent then return false end
	if char:GetAttribute("Sliding") then return false end
	for _, state in { "IsStunned", "IsSoftStunned", "GuardBroken", "IsAttacking",
		"IsUptilt", "DoingMove", "IsAwakening", "Grabbed",
		"IsWallRunning", "IsWallStepping" } do
		if char:GetAttribute(state) then return false end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	-- Grounded only: sliding needs a floor.
	local state = hum:GetState()
	return state ~= Enum.HumanoidStateType.Jumping
		and state ~= Enum.HumanoidStateType.Freefall
		and state ~= Enum.HumanoidStateType.Climbing
end
local CancelAirDetect = nil
local CancelUptiltDetect = nil
local CancelDownslamDetect = nil

local AIR_M1_GROUND_CLEARANCE = 0.25
local HRP_TO_FLOOR = 3 

local function isAirborne(char, hrp, clearance)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances =
		{char, workspace.HITBOXES, workspace.Debris, workspace.VFX}
	params.FilterType = Enum.RaycastFilterType.Exclude
	local hit = workspace:Raycast(
		hrp.Position,
		Vector3.new(0, -(HRP_TO_FLOOR + (clearance or AIR_M1_GROUND_CLEARANCE)), 0),
		params)
	return hit == nil
end

local AIR_M1_MAX_HORIZONTAL_SPEED = 95
local AIR_M1_MAX_VERTICAL_SPEED = 95
local AIR_M1_PUSH = 50          
local AIR_M1_PUSH_MAX = 70      
local AIR_M1_FREEZE_LEAD = 0.06  
local AIR_M1_FREEZE_MAX = 0.75   
local AIR_M1_RELEASE_HEIGHT = 0.5  
local AIR_M1_ANIM_SPEED = 1.2     
local AIR_M1_ACTION_LOCK = 0.5


local UPTILT_PUSH_DELAY = 0.12
local UPTILT_PUSH_STRENGTH = 50
local UPTILT_PUSH_TIME = 0.18

local function getWeaponEffect(weaponName)
	local weapon = ReplicatedStorage.Weapons:FindFirstChild(weaponName)
	local scripts = weapon and weapon:FindFirstChild("Scripts")
	local mod = scripts and scripts:FindFirstChild(weaponName)
	local effects = mod and mod:FindFirstChild("Effects")
	local effectMod = effects and effects:FindFirstChild(weaponName .. "Effect")
	return effectMod and require(effectMod) or nil
end

function M1Handler.new(controller)
	local self = setmetatable({}, {__index = M1Object})
	self.__Trove = Trove.new()
	self.Controller = controller
	self.localM1Count = 1
	self.lastM1Time = 0
	self.nextM1AllowedTime = 0
	self.Buffered = false
	self.ChainOpen = false
	self.CurrentTrack = nil
	self.CurrentSeq = nil

	-- Reset combo on stun
	self.__Trove:Connect(
		controller.Character:GetAttributeChangedSignal("IsStunned"),
		function()
			if controller.Character:GetAttribute("IsStunned") then
				self:ResetCombo()
			end
		end
	)
	

	self.__Trove:Connect(
		controller.Character:GetAttributeChangedSignal("IsSoftStunned"),
		function()
			if controller.Character:GetAttribute("IsSoftStunned") then
				self:ResetCombo()
			end
		end
	)

	self.__Trove:Connect(
		controller.Character:GetAttributeChangedSignal("Parried"),
		function()
			if controller.Character:GetAttribute("Parried") then
				self:ResetCombo()
			end
		end
	)
	

	
	local previewMobileButtonsOnPc = false
	if UIS.TouchEnabled or previewMobileButtonsOnPc then
		task.spawn(function()
			local plr = Players.LocalPlayer
			local playerGui = plr:WaitForChild("PlayerGui")
			local combatUI = playerGui:WaitForChild("CombatUI", 10)
			if not combatUI then
				warn("M1Handler: CombatUI not found")
				return
			end

			local uptiltButton
			local startTime = os.clock()
			repeat
				uptiltButton = combatUI:FindFirstChild("Uptilt", true)
				if uptiltButton then break end
				task.wait(0.1)
			until os.clock() - startTime >= 10

			if not uptiltButton then
				warn("M1Handler: Uptilt button not found")
				return
			end

			self.__Trove:Connect(uptiltButton.Activated, function()
				if plr:GetAttribute("EditingMobileButtons") then return end
				local char = controller.Character
				if char:GetAttribute("IsStunned")
					or char:GetAttribute("IsSoftStunned")
					or char:GetAttribute("IsBlocking")
					or char:GetAttribute("Iframe")
					or char:GetAttribute("DashIframe")
					or char:GetAttribute("IsUptilt") then
					return
				end
				if char:GetAttribute("WeaponEquipped") then
					-- Air M1 briefly locks out uptilt (AIR_M1_ACTION_LOCK).
					local lockUntil = char:GetAttribute("AirM1LockUntil")
					if lockUntil and os.clock() < lockUntil then return end
					self:DoUptilt()
				end
				
			end)
		end)
	end

	return self
end

function M1Object.TryM1(self)
	local controller = self.Controller
	local char = controller.Character
	local hum = controller.Humanoid

	if UIManager.AnyOpen() then return end

	if char:GetAttribute("Sliding") then
		local action = controller.Actions
		local slideAction = action and action.ActionMap
			and action.ActionMap.Combat
			and action.ActionMap.Combat["Slide"]
		if action and slideAction and slideAction.Module and slideAction.Module.End then
			slideAction.Module.End(controller)
		end
		-- Fall through: the swing runs this frame, not next. The gates below still
		-- apply, so a slide ending into a stun still rejects.
	end

	if char:GetAttribute("IsStunned")
		or char:GetAttribute("IsAttacking")
		or char:GetAttribute("IsSoftStunned")
		or char:GetAttribute("IsBlocking")
		or char:GetAttribute("Iframe") then
		return
	end

	if char:GetAttribute("CanDownslam") and char:GetAttribute("IsUptilt") and char:GetAttribute("WeaponEquipped") and not char:GetAttribute("IsAttacking") then
		self:DoDownslam()
	elseif not UIS.TouchEnabled and UIS:IsKeyDown(Enum.KeyCode.LeftControl) and char:GetAttribute("WeaponEquipped") and not char:GetAttribute("IsAttacking") then
		local uptiltLock = char:GetAttribute("AirM1LockUntil")
		if uptiltLock and os.clock() < uptiltLock then return end
		self:DoUptilt()
	elseif isAirborne(char, controller.Root)
		and not char:GetAttribute("IsUptilt")
		and not char:GetAttribute("CanDownslam") and char:GetAttribute("WeaponEquipped") and not char:GetAttribute("IsAttacking")then
		local hrp = controller.Root
		local vel = hrp.AssemblyLinearVelocity
		local horizSpeed = Vector3.new(vel.X, 0, vel.Z).Magnitude
		local vertSpeed = math.abs(vel.Y)
		
		if horizSpeed <= AIR_M1_MAX_HORIZONTAL_SPEED and vertSpeed <= AIR_M1_MAX_VERTICAL_SPEED then
			self:DoAirM1()
		end
	else
		if not char:GetAttribute("WeaponEquipped") or isAirborne(char, controller.Root) then return end
		self:M1Attack()
	end
end

function M1Object.M1Attack(self)
	local controller = self.Controller
	local char = controller.Character
	local now = os.clock()

	-- If animation is playing and chain isn't open, reject entirely
	if self.CurrentTrack and self.CurrentTrack.IsPlaying and not self.ChainOpen then
		return
	end

	if now < (self.nextM1AllowedTime or 0) then
		return -- reject, no retry scheduling
	end

	local stats = WeaponData.GetWeaponStats(char)
	local timing = CombatTiming.GetWeapon(char:GetAttribute("CurrentWeapon") or "Fists")
	local chainWindow = (timing and timing.comboWindow) or Configuration.M1ChainWindow
	if now - self.lastM1Time > chainWindow then
		self.localM1Count = 1
	else
		self.localM1Count = (self.localM1Count % stats.maxM1) + 1
	end

	self.lastM1Time = now
	self:DoM1()
end

-- Input queue window for sliding. 
function M1Object.QueueSlide(self)
	self._QueuedSlideAt = os.clock()
end

function M1Object.ProcessQueuedInput(self)
	local controller = self.Controller
	local char = controller and controller.Character
	if not char or not char.Parent then
		self._QueuedSlideAt = nil
		return
	end

	if not self._QueuedSlideAt then return end

	local now = os.clock()
	if now - self._QueuedSlideAt > INPUT_QUEUE_WINDOW then
		self._QueuedSlideAt = nil
		return
	end

	if canSlideNow(char) then
		self._QueuedSlideAt = nil
		local action = controller.Actions
		local slideAction = action and action.ActionMap
			and action.ActionMap.Combat
			and action.ActionMap.Combat["Slide"]
		if action and slideAction then
			action:RunSkill(slideAction)
		end
	end
end

