function M1Object.ResetCombo(self)
	self.localM1Count = 1
	self.lastM1Time = 0
	self.nextM1AllowedTime = 0
	self.Buffered = false
	self.ChainOpen = false
	if self.CurrentSeq then
		self.CurrentSeq:Cancel()
		self.CurrentSeq = nil
	end
end

function M1Object.DoM1(self)
	
	local controller = self.Controller
	local char = controller.Character
	local curWeapon = char:GetAttribute("CurrentWeapon")

	if char:GetAttribute("DashIframe") then
		char:SetAttribute("NoDashCancel", true)

		local token = (char:GetAttribute("NoDashCancelToken") or 0) + 1
		char:SetAttribute("NoDashCancelToken", token)

		local commit = CombatTiming.GetTotalCommit(curWeapon, self.localM1Count)
			or Configuration.M1ChainCooldown or 0.6
		task.delay(commit, function()
			if not char.Parent then return end
			if char:GetAttribute("NoDashCancelToken") ~= token then return end
			char:SetAttribute("NoDashCancel", nil)
		end)
	end
	
	self.ChainOpen = false

	if self.CurrentSeq then
		self.CurrentSeq:Cancel()
		self.CurrentSeq = nil
	end

	if self.CurrentTrack and self.CurrentTrack.IsPlaying then
		self.CurrentTrack:Stop(Configuration.M1BlendTime)
	end
	

	local stats = WeaponData.GetWeaponStats(char)

	local animCount = self.localM1Count
	
	char.Humanoid.AutoRotate = false
	local weapon = controller:GetWeapon()
	

	local track
	if weapon and weapon.HandleEffect then
		if char:GetAttribute("IsAttacking") then return end
		if char:GetAttribute("IsBlocking") then
			char.Humanoid.AutoRotate = true
			return
		end
		track = weapon.HandleEffect(controller, animCount)
	else
		print("Error")
	end

	self.CurrentTrack = track
	lastM1Track = track

	if not SkillDash.HoldForDash(char, track, M1_DASH_FREEZE) then
		self.CurrentTrack = nil
		return
	end

	local swing = CombatTiming.GetM1(curWeapon, animCount)
	local animSpeed = CombatTiming.GetM1Speed(curWeapon, animCount)
	local hitFrame = ((swing and swing.hitOffset or 0.3) * animSpeed) * 60
	
	
	-- the combo finisher gets its own cue where a weapon defines one
	local swingSound = "Swing"
	local finisher = FINISHER_SOUND[curWeapon]
	if finisher and animCount == WeaponData.GetStat(curWeapon, "maxM1") then
		swingSound = finisher
	end
	SoundHandler.Play(swingSound, controller.Root, curWeapon)
	
	if char:GetAttribute("IsBlocking") then
		if track and track.IsPlaying then
			track:Stop(Configuration.M1BlendTime)
		end
		self.CurrentTrack = nil
		char.Humanoid.AutoRotate = true
		-- Revert the combo step back so blocking doesn't eat a swing in the chain.
		self.localM1Count = math.max((self.localM1Count or 1) - 1, 0)
		return
	end

	CombatEvent:FireServer("M1")

	local now = os.clock()
	if animCount >= stats.maxM1 then
		local timing = CombatTiming.GetWeapon(curWeapon)
		self.nextM1AllowedTime = now + ((timing and timing.combatCD) or Configuration.M1ChainCooldown)
	else
		self.nextM1AllowedTime = now + (swing and swing.recovery or 0)
	end


	if track and track.Length > 0 then
		local sweepDuration = math.max(swing and swing.active or 0.05, 0.03)
		hitFrame = math.max(1, math.min(hitFrame, track.Length * 60 - 2))
		local endFrame = math.max(hitFrame + 1, track.Length * 60 - Configuration.M1EndLead * 60)
		local Seq = Sequencer.ForTrack(track)
			:At(hitFrame, function()
				HitDetect.Sweep(char, "M1Hitbox", sweepDuration)
			end)
			:At(endFrame, function()
				--self.ChainOpen = true
				--self:FireBuffered()
			end)
			:Start()
		self.CurrentSeq = Seq
		track.Stopped:Once(function()
			if self.CurrentSeq ~= Seq then return end
			self.CurrentSeq = nil
			Seq:Cancel()
			self.ChainOpen = true
			--self:FireBuffered()
		end)
	else
		local sweepDuration = math.max(swing and swing.active or 0.05, 0.03)
		task.delay(swing and swing.hitOffset or 0.3, function()
			HitDetect.Sweep(char, "M1Hitbox", sweepDuration)
		end)
		local fallback = math.max(WeaponData.GetCD(char, "m1CD", animCount) - Configuration.M1EndLead, 0.05)
		task.delay(fallback, function()
			self.ChainOpen = true
			--self:FireBuffered()
		end)
	end
end

function M1Object.DoAirM1(self)
	local controller = self.Controller
	if localAirM1Debounce then return end

	local char = controller.Character
	if not char or char:GetAttribute("IsUptilt") or char:GetAttribute("CanDownslam") or char:GetAttribute("IsAttacking") or char:GetAttribute("IsBlocking") or char:GetAttribute("IsStunned") then return end

	local hrp = controller.Root
	local hum = controller.Humanoid
	local curWeapon = char:GetAttribute("CurrentWeapon")

	-- Keep Air M1 responsive without allowing extreme fling velocity.
	local vel = hrp.AssemblyLinearVelocity
	local horizSpeed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local vertSpeed = math.abs(vel.Y)

	if horizSpeed > AIR_M1_MAX_HORIZONTAL_SPEED or vertSpeed > AIR_M1_MAX_VERTICAL_SPEED then return end

	localAirM1Debounce = true

	local wasSprinting = SprintResume.WasSprinting(controller)

	local combatFolder = ReplicatedStorage.Anims.Combat[curWeapon].Combat
	local anim = combatFolder:FindFirstChild("AirM1") or combatFolder:FindFirstChild("Combat1")
	if not anim then
		localAirM1Debounce = false
		return
	end

	CombatEvent:FireServer("AirM1")

	local swing = CombatTiming.GetM1(curWeapon, 1)
	local hitOffset = (swing and swing.hitOffset) or 0.3

	-- Carry starting velocity into the boost forwards.
	local startVel = hrp.AssemblyLinearVelocity
	local look = hrp.CFrame.LookVector * Vector3.new(1, 0, 1)
	if look.Magnitude > 0.05 then
		look = look.Unit
	else
		look = Vector3.zero
	end

	local boosted = Vector3.new(startVel.X, 0, startVel.Z) + look * AIR_M1_PUSH
	if boosted.Magnitude > AIR_M1_PUSH_MAX then
		boosted = boosted.Unit * AIR_M1_PUSH_MAX
	end
	hrp.AssemblyLinearVelocity = Vector3.new(boosted.X, startVel.Y, boosted.Z)

	local track = controller.Animator:Animate({
		Animation = anim,
		Priority = Enum.AnimationPriority.Action4,
		Speed = AIR_M1_ANIM_SPEED,
		Looped = false,
	})
	if CancelAirDetect then
		CancelAirDetect()
	end

	local stopped = false
	local released = false
	local posCheck
	local freezeStart

	local function cleanup()
		if stopped then return end
		stopped = true
		if posCheck then
			posCheck:Disconnect()
			posCheck = nil
		end
		if track and track.IsPlaying then
			track:AdjustSpeed(AIR_M1_ANIM_SPEED) -- never leave a track frozen
		end
		task.delay(WeaponData.GetCD(char, "airM1CD"), function()
			localAirM1Debounce = false
		end)

		if SprintResume.ShouldResume(controller, wasSprinting) then
			SprintResume.Restart(controller, wasSprinting)
			return
		end

		SprintResume.ResetAutoTimer()

		local idleAnim = ReplicatedStorage.Anims.Combat[curWeapon].Main
			:FindFirstChild("EquippedIdle")
		if idleAnim then
			controller.Animator:Animate({
				Animation = idleAnim,
				Priority = Enum.AnimationPriority.Action,
			})
		end
	end


	local function release()
		if released or stopped then return end
		released = true
		if track then
			track:AdjustSpeed(AIR_M1_ANIM_SPEED)
		end

		CancelAirDetect = HitDetect.FromTrack(char, track, "AirM1Hitbox", 0.3, 0.1)
		local effectsPlay = getWeaponEffect(char:GetAttribute("CurrentWeapon"))
		if effectsPlay then
			effectsPlay.Play(char, char:GetAttribute("CurrentWeapon") .. "AirM1")
		end

		local airCommit = CombatTiming.GetAirM1Commit(curWeapon)
		if airCommit then
			self.nextM1AllowedTime = os.clock() + airCommit
		end

		char:SetAttribute("AirM1LockUntil", os.clock() + AIR_M1_ACTION_LOCK)

		CombatEvent:FireServer("AirM1Release")
	end

	posCheck = game:GetService("RunService").RenderStepped:Connect(function()
		if stopped then return end
		if not hrp or not hrp.Parent then
			cleanup()
			return
		end

		-- Stun cancels the whole swing
		if char:GetAttribute("IsStunned")
			or char:GetAttribute("IsSoftStunned") then
			cleanup()
			return
		end

		if not released then
			local clipHit = CombatTiming.GetAirM1ClipHit(curWeapon)
			local freezeAt = CombatTiming.GetAirM1FreezeAt(curWeapon)
			if not freezeStart and track and track.IsPlaying
				and track.TimePosition >= freezeAt then
				freezeStart = os.clock()
				track:AdjustSpeed(0)
			end

			if freezeStart then
				if not isAirborne(char, hrp, AIR_M1_RELEASE_HEIGHT)
					or os.clock() - freezeStart >= AIR_M1_FREEZE_MAX then
					release()
				end
			end
		end
	end)

	if track then
		track.Stopped:Connect(cleanup)
	end
end

function M1Object.DoUptilt(self)
	local controller = self.Controller
	local char = controller.Character
	local hrp = controller.Root
	local now = os.clock()

	if controller.Humanoid.FloorMaterial == Enum.Material.Air then return end
	
	if localUptiltDebounce then return end

	if char:GetAttribute("IsUptilt") then return end
	if char:GetAttribute("IsStunned") then return end
	if char:GetAttribute("IsSoftStunned") then return end
	if char:GetAttribute("IsAttacking") then return end
	if char:GetAttribute("IsBlocking") then return end
	
	
	local curWeapon = char:GetAttribute("CurrentWeapon")
	local anim = ReplicatedStorage.Anims.Combat[curWeapon].Combat:FindFirstChild("Uptilt")
	if not anim then return end
	localUptiltDebounce = true
	
	

	local track = controller.Animator:Animate({
		Animation = anim,
		Priority = Enum.AnimationPriority.Action4,
		Speed = 0.9,
	})
	if CancelUptiltDetect then
		CancelUptiltDetect()
	end
	CancelUptiltDetect = HitDetect.FromTrack(char, track, "UptiltHitbox")
	
	local attach = Instance.new("Attachment")
	attach.Name = "UptiltStartAttachment"
	attach.Parent = hrp

	local vel = Instance.new("LinearVelocity")
	vel.Attachment0 = attach
	vel.MaxForce = 500000
	vel.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	vel.VectorVelocity = Vector3.zero
	vel.Parent = hrp

	local pushCancelled = false
	local function endPush()
		if pushCancelled then return end
		pushCancelled = true
		if vel and vel.Parent then vel:Destroy() end
		if attach and attach.Parent then attach:Destroy() end
	end

	task.delay(UPTILT_PUSH_DELAY, function()
		if pushCancelled or not char.Parent then endPush() return end
		-- don't lunge if the swing got interrupted during the windup
		if char:GetAttribute("IsStunned")
			or char:GetAttribute("IsSoftStunned")
			or char:GetAttribute("IsBlocking") then
			endPush()
			return
		end

		local startTime = os.clock()
		local conn
		conn = RunService.Heartbeat:Connect(function()
			if pushCancelled or not char.Parent or not hrp.Parent then
				conn:Disconnect()
				endPush()
				return
			end
			-- cut the push short if we get hit out of it
			if char:GetAttribute("IsStunned") or char:GetAttribute("IsSoftStunned") then
				conn:Disconnect()
				endPush()
				return
			end

			local alpha = math.clamp((os.clock() - startTime) / UPTILT_PUSH_TIME, 0, 1)
			local dir = hrp.CFrame.LookVector * Vector3.new(1, 0, 1)
			if dir.Magnitude > 0.01 then
				dir = dir.Unit
			else
				dir = Vector3.zero
			end

			vel.VectorVelocity = dir * (UPTILT_PUSH_STRENGTH * (1 - alpha))

			if alpha >= 1 then
				conn:Disconnect()
				endPush()
			end
		end)
	end)
	
	SoundHandler.Play("Swing", controller.Root, curWeapon)

	CombatEvent:FireServer("Uptilt")
	controller.Camera:TweenFOV({
		FOV = 75,
		In = TweenInfo.new(0.1),
		Hold = 0.3,
		Out = TweenInfo.new(0.2),
		EndFOV = 70,
	})

	local conn
	conn = char:GetAttributeChangedSignal("IsUptilt"):Connect(function()
		if char:GetAttribute("IsUptilt") then
			conn:Disconnect()
			controller.Camera:TweenFOV({
				FOV = 80,
				In = TweenInfo.new(0.3),
			})
		else
			conn:Disconnect()
			controller.Camera:Reset()
		end
	end)

	task.delay(WeaponData.GetCD(char, "uptiltCD"), function()
		localUptiltDebounce = false
	end)
end

function M1Object.DoDownslam(self)
	local controller = self.Controller
	local char = controller.Character

	if localDownslamDebounce then return end
	localDownslamDebounce = true

	local curWeapon = char:GetAttribute("CurrentWeapon")
	local anim = ReplicatedStorage.Anims.Combat[curWeapon].Combat:FindFirstChild("Downslam")
	if not anim then return end

	local track = controller.Animator:Animate({
		Animation = anim,
		Priority = Enum.AnimationPriority.Action4,
	})
	if CancelDownslamDetect then
		CancelDownslamDetect()
	end
	CancelDownslamDetect = HitDetect.FromTrack(char, track, "DownslamHitbox")
	
	SoundHandler.Play("Swing", controller.Root, curWeapon)
	CombatEvent:FireServer("Downslam")

	controller.Camera:TweenFOV({
		FOV = 85,
		In = TweenInfo.new(0.05),
		Hold = 0.2,
		Out = TweenInfo.new(0.3),
		EndFOV = 70,
	})

	CamShakeEvent:FireServer("Downslam")

	local conn
	conn = char:GetAttributeChangedSignal("IsUptilt"):Connect(function()
		if not char:GetAttribute("IsUptilt") then
			conn:Disconnect()
			controller.Camera:Reset()
		end
	end)

	task.delay(WeaponData.GetCD(char, "downslamCD"), function()
		localDownslamDebounce = false
	end)
end

function M1Object.Clean(self)
	self.__Trove:Clean()
end

