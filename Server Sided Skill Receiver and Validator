local counterHooks = {}
function SkillService.SetCounterHook(fn)
	if type(fn) == "function" and not table.find(counterHooks, fn) then
		table.insert(counterHooks, fn)
	end
end


function SkillService.CheckCounter(char, eChar)
	for _, hook in counterHooks do
		if hook(eChar, char) then
			SkillService.HitboxDelete(char)
			return true
		end
	end
	return false
end

